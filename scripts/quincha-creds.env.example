# Credenciales de acceso remoto a Quincha Systems (NO COMMITEAR)
# Copiar este archivo a:  scripts/quincha-creds.env
# y completar con los valores reales.
# Este archivo (.env) está en .gitignore, no se sube al repo.
# Auth principal: clave SSH (%USERPROFILE%\.ssh\id_ed25519_quincha).
# QUINCHA_PASS es solo documentación / fallback manual.

QUINCHA_HOST=127.0.0.1
QUINCHA_PORT=2222
QUINCHA_USER=serverpi
# ---- TU CONTRASEÑA REAL AQUÍ (no commitear) ----
QUINCHA_PASS=__PONER_CONTRASEÑA__
# Fingerprint del host (informativo; el script usa StrictHostKeyChecking=no por el túnel)
QUINCHA_HOSTKEY=ssh-ed25519 255 SHA256:WPP2eKsKwdQks3apQkPtS0yq5/1837RvjNVIYKNBOSE
# Ruta de la clave SSH (relativa al usuario)
QUINCHA_KEY=%USERPROFILE%\.ssh\id_ed25519_quincha
